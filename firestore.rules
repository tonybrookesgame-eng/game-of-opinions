rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Matches the client-side admin gate in admin.html - this is the only
    // account allowed to bypass per-user ownership checks. Previously this
    // returned true for any signed-in user, meaning every user could write
    // to (and tamper with) anyone else's leaderboard, team, or predictions
    // data directly via the Firestore SDK, bypassing the app's UI entirely.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "tonybrookes.game@gmail.com";
    }

    function isLeagueCreator() {
      return isSignedIn() && resource.data.creator == request.auth.uid;
    }

    // Allow a signed-in user to add only themselves to a league membership list.
    function isSelfJoinUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["members", "updatedAt"])
        && request.resource.data.members.hasAll(resource.data.members)
        && !resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members.hasAll([request.auth.uid])
        && request.resource.data.members.size() == resource.data.members.size() + 1;
    }

    // saveTeam() in myxi.html re-touches the league doc on every save (not
    // just the first), so an already-joined member re-saving their team
    // sends back the identical member list plus a fresh updatedAt. Without
    // this, isSelfJoinUpdate() rejects it (it only permits the one-time
    // not-a-member -> member transition), so every save after the first
    // failed with permission-denied. This only allows a no-op refresh -
    // the member list itself must stay byte-for-byte the same.
    function isSelfRefresh() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["members", "updatedAt"])
        && request.resource.data.members.hasAll(resource.data.members)
        && resource.data.members.hasAll(request.resource.data.members)
        && resource.data.members.hasAny([request.auth.uid]);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (isOwner(uid) || isAdmin() || resource.data.public == true);
      allow create, update: if isSignedIn() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();

      // Squad, weekly picks, and Bet Builder choice - readable by any signed-in
      // manager now the season's underway, so managers can view each other's
      // teams from the league table. Writes stay owner/admin-only.
      match /myxi/{doc} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwner(uid) || isAdmin());
      }

      match /stats/{doc} {
        allow read: if isSignedIn() && (isOwner(uid) || isAdmin());
        allow write: if isSignedIn() && (isOwner(uid) || isAdmin());
      }

      // Per-gameweek archive (team/picks/bet/points snapshot) - same public
      // read as myxi/ above, so "view manager" can show past weeks too.
      match /history/{doc} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwner(uid) || isAdmin());
      }

      match /analytics/{doc} {
        allow read: if isSignedIn() && (isOwner(uid) || isAdmin());
        allow write: if isSignedIn() && (isOwner(uid) || isAdmin());
      }

      // Season predictions - same reasoning as myxi/ above.
      match /predictions/{doc} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isOwner(uid) || isAdmin());
      }
    }

    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
    }

    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.creator == request.auth.uid
        && request.resource.data.members.hasAll([request.auth.uid])
      ) || (
        isSignedIn()
        && leagueId == "L-GLOBAL"
        && request.resource.data.creator == "system"
        && request.resource.data.code == "GLOBAL"
        && request.resource.data.isGlobal == true
        && request.resource.data.members.hasAll([request.auth.uid])
      );
      allow update: if isAdmin() || isLeagueCreator() || isSelfJoinUpdate() || isSelfRefresh();
      allow delete: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /gameweekHistory/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Aggregate-only stats shown on the public marketing page (e.g. manager
    // count). Deliberately its own tiny collection, separate from
    // users/leaderboard, so the public read here can never expose individual
    // user data - only whatever admin.html explicitly writes into it.
    match /public/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
